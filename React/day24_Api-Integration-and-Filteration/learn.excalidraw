      "text": "day 24: api integration, serach or filter: \nToday we implete filter, serach, api integration of our last class project. \non products folder I created 4 folder ui, api, state, hooks. on api folder i created productApi.jsx file\nthen inside i wrote this code:\nimport { api } from \"../../../config/api\";\n\nexport const getProducts = async (search) => {\n  let url = search ? `/products/search?q=${search}` : \"/products?limit=194\";\n  try {\n    let res = await api.get(url);\n    return res.data;\n  } catch (error) {\n    console.log(\"product api error: \", error);\n  }\n};\n\nexport const getProductsCategory = async () => {\n  try {\n    let res = await api.get(\"/products/categories\");\n    return res.data;\n  } catch (error) {\n    console.log(\"product api category error: \", error);\n  }\n};\n\nexport const getProductsByCategory = async (category) => {\n  try {\n    let res = await api.get(`/products/category/${category}`);\n    return res.data;\n  } catch (error) {\n    console.log(\"Get products by category error: \", error);\n  }\n};\n\ngetproducts function for get product by user search otherwise it's return all existed products.\nand geProductCategory function return all category of product that present in dummy.json api. and \ngetRpoductsByCategory function return user selected category products. \n\nthen product/hooks inside folder i create useProductHook.jsx file inside i wrote this code:\nimport { timeoutManager, useQuery } from \"@tanstack/react-query\";\nimport {\n  getProducts,\n  getProductsByCategory,\n  getProductsCategory,\n} from \"../api/ProductApi\";\nimport { useEffect, useState } from \"react\";\n\nexport const useAllProducts = () => {\n  const [search, setSearch] = useState(null);\n  const [debounce, setDebounce] = useState(null);\n\n  useEffect(() => {\n    const timeOut = setTimeout(() => {\n      setDebounce(search);\n    }, 700);\n    return () => clearTimeout(timeOut);\n  }, [search]);\n\n  const { data, isPending, error } = useQuery({\n    queryKey: [\"products\", debounce],\n    queryFn: () => getProducts(debounce),\n  });\n  return {\n    data,\n    isPending,\n    error,\n    search,\n    setSearch,\n  };\n};\n\nexport const useAllCategorys = () => {\n  return useQuery({\n    queryKey: [\"AllCategory\"],\n    queryFn: getProductsCategory,\n  });\n};\n\nexport const useProductByCategory = () => {\n  const [category, setCategory] = useState(null);\n  let { data, isPending, error } = useQuery({\n    queryKey: [\"productsByCategory\", category],\n    queryFn: () => getProductsByCategory(category),\n  });\n  return {\n    data,\n    isPending,\n    error,\n    category,\n    setCategory,\n  };\n};\n\n\nI used tanstack query for simply fetch data from api, and for loading state and for cache for\napi responce, means don't need to call api again on every render. \nfirst i useAllProducts function or we can say custom hook, inside I created search state,\nbebouce state, when user search then on setSearch get the input data, so every time our api\nhit so for that i used debouce concept, for that i created useEffect inside i wrote setTimout\nfunction and inside i store search input inside  SetDebouce state. then i set 700s timeout and\ni used cleanup function of useEffect for clear the time intervel and gave defendency array [search]\n and then i used useQuery inside i wrote queryKey and qeuryFn and callled getProducts(debouce)\nand return data, isPending, error, search, setSeach. \n \nonly I created another custom hook useAllCategory function inside this i used useQuery and gave\nqueryKey: [\"allCategory\"] and queryFn: getProductsCategory called.\n\nalso another custore hook is useProductByCategory function i created inside category state created\nand i used userQuery inside queryKey: [\"productsBYCategory\", category] and quryFun: called\n getProductsByCategory(category) and return data, ispending, error, category, setCategory. \n\nnow in product/ui/pages inside i creted productPage.jsx component inside i wrote this code:\nimport Filter from \"../../../../shared/ui/components/Filter\";\nimport {\n  useAllProducts,\n  useProductByCategory,\n} from \"../../hooks/useProductHook\";\nimport ProductCard from \"../components/ProductCart\";\n\nconst ProductPage = () => {\n  const { isPending, data, error, search, setSearch } = useAllProducts();\n  const {\n    data: productsByCategory,\n    category,\n    setCategory,\n  } = useProductByCategory();\n\n  if (isPending) return <h1>loading</h1>;\n  return (\n    <div>\n      <Filter\n        category={category}\n        setCategory={setCategory}\n        search={search}\n        setSearch={setSearch}\n      />\n      <div className=\"grid grid-cols-1 xl:grid-cols-5 p-4 lg:grid-cols-4 md:grid-cols-3 min-[450px]:grid-cols-2 max-[450px]:grid-1  gap-4\">\n        {productsByCategory?.products.length\n          ? productsByCategory.products.map((val) => (\n              <ProductCard key={val.id} product={val} />\n            ))\n          : data.products.map((val) => (\n              <ProductCard key={val.id} product={val} />\n            ))}\n      </div>\n    </div>\n  );\n};\n\nexport default ProductPage;\n\n then inside productPage i desturcture the custom hook isPending, data, error, serach, setSearch from\nuseAllProducts() custom hook and from useProductByCategory() hook I destructure\ndata: productsByCategory,\n    category,\n    setCategory,\nthen if isPending then return h1 inside loading text, \nand below return jsx. filter and pass props \n   <Filter\n        category={category}\n        setCategory={setCategory}\n        search={search}\n        setSearch={setSearch}\n      />\nin src/shared/ui/component folder i filter.jsx and productCart.jsx and wrote this below code.\nthis is for filter:\n\nimport { Search, ChevronDown } from \"lucide-react\";\nimport { useAllCategorys } from \"../../../features/product/hooks/useProductHook\";\n\nconst Filter = ({search, setSearch, category, setCategory}) => {\n  const { isPending, data, error } = useAllCategorys();\n\n  if (isPending) return <h1>Loading...</h1>;\n\n  return (\n    <div className=\"w-full rounded-2xl bg-zinc-900/25 p-3 shadow-xl shadow-black/20 backdrop-blur-xl\">\n      <div className=\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\">\n        {/* ================= SEARCH BAR ================= */}\n        <div className=\"group relative w-full sm:max-w-md\">\n          <Search\n            size={19}\n            className=\"pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500 transition-colors duration-300 group-focus-within:text-violet-400\"\n          />\n\n          <input\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            type=\"text\"\n            placeholder=\"Search products...\"\n            className=\"h-12 w-full rounded-xl border border-white/10 bg-zinc-950/80 pl-11 pr-4 text-sm text-white outline-none placeholder:text-zinc-600 transition-all duration-300 hover:border-white/20 focus:border-violet-500/50 focus:bg-zinc-950 focus:ring-4 focus:ring-violet-500/10\"\n          />\n        </div>\n\n        {/* ================= CATEGORY ================= */}\n        <div className=\"relative w-full sm:w-56\">\n          <select\n            value={category}\n            onChange={(e) => setCategory(e.target.value)}\n            className=\"h-12 w-full cursor-pointer appearance-none rounded-xl border border-white/10 bg-zinc-900 backdrop-blur-xl px-4 pr-11 text-sm font-medium text-zinc-300 outline-none transition-all duration-300 hover:border-white/20 focus:border-violet-500/50 focus:ring-4 focus:ring-violet-500/10\"\n            defaultValue=\"all\"\n          >\n            <option value=\"\">Select Category</option>\n            {data.map((item) => (\n              <option key={item.slug} value={item.slug}>\n                {item.name}\n              </option>\n            ))}\n          </select>\n\n          <ChevronDown\n            size={18}\n            className=\"pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-zinc-500\"\n          />\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Filter;\n\n\n\nthis is a product card code:\n\nimport { ShoppingCart, Star, ArrowUpRight } from \"lucide-react\";\n\nconst ProductCard = ({ product }) => {\n  const {\n    title,\n    price,\n    discountPercentage,\n    rating,\n    thumbnail,\n    category,\n    availabilityStatus,\n  } = product;\n\n  return (\n    <div className=\"group relative overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/70 shadow-xl shadow-black/20 backdrop-blur-sm transition-all duration-500 hover:-translate-y-1 hover:border-violet-500/40 hover:shadow-violet-500/10\">\n\n      {/* ================= IMAGE ================= */}\n      <div className=\"relative m-2 overflow-hidden rounded-xl bg-zinc-800\">\n        <img\n          src={thumbnail}\n          alt={title}\n          className=\"h-55 w-full object-cover transition-transform duration-700 group-hover:scale-110\"\n        />\n\n        {/* Discount */}\n        <div className=\"absolute left-3 top-3 rounded-full bg-violet-600 px-3 py-1 text-xs font-bold text-white shadow-lg\">\n          -{Math.round(discountPercentage)}%\n        </div>\n\n        {/* Quick View */}\n        <button\n          type=\"button\"\n          className=\"absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full border border-white/20 bg-black/50 text-white opacity-0 backdrop-blur-md transition-all duration-300 group-hover:opacity-100 hover:bg-violet-600\"\n        >\n          <ArrowUpRight size={17} />\n        </button>\n\n        {/* Image Overlay */}\n        <div className=\"pointer-events-none absolute inset-0 bg-linear-to-t from-black/30 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100\" />\n      </div>\n\n      {/* ================= CONTENT ================= */}\n      <div className=\"p-4\">\n\n        {/* Category + Stock */}\n        <div className=\"mb-2 flex items-center justify-between\">\n          <span className=\"text-xs font-medium capitalize text-violet-400\">\n            {category}\n          </span>\n\n          <span\n            className={`text-xs font-medium ${\n              availabilityStatus === \"In Stock\"\n                ? \"text-emerald-400\"\n                : \"text-red-400\"\n            }`}\n          >\n            {availabilityStatus}\n          </span>\n        </div>\n\n        {/* Title */}\n        <h2 className=\"line-clamp-2 min-h-12 text-base font-semibold leading-6 text-white transition-colors duration-300 group-hover:text-violet-400\">\n          {title}\n        </h2>\n\n        {/* Rating */}\n        <div className=\"mt-3 flex items-center gap-2\">\n          <div className=\"flex items-center gap-1 rounded-md bg-amber-400/10 px-2 py-1\">\n            <Star\n              size={14}\n              className=\"fill-amber-400 text-amber-400\"\n            />\n            <span className=\"text-xs font-semibold text-amber-300\">\n              {rating}\n            </span>\n          </div>\n\n          <span className=\"text-xs text-zinc-500\">\n            Customer rating\n          </span>\n        </div>\n\n        {/* Price */}\n        <div className=\"mt-4 flex items-end gap-2\">\n          <span className=\"text-2xl font-bold text-white\">\n            ${price}\n          </span>\n\n          <span className=\"pb-1 text-sm text-zinc-500 line-through\">\n            ${(price / (1 - discountPercentage / 100)).toFixed(2)}\n          </span>\n        </div>\n\n        {/* Add To Cart */}\n        <button\n          type=\"button\"\n          className=\"mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-linear-to-r from-violet-600 to-fuchsia-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-600/20 transition-all duration-300 hover:from-violet-500 hover:to-fuchsia-500 hover:shadow-violet-500/30 active:scale-[0.98]\"\n        >\n          <ShoppingCart size={18} />\n          Add to Cart\n        </button>\n      </div>\n    </div>\n  );\n};\n\nexport default ProductCard;\n\n\n\n\n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "day 24: api integration, serach or filter: \nToday we implete filter, serach, api integration of our last class project. \non products folder I created 4 folder ui, api, state, hooks. on api folder i created productApi.jsx file\nthen inside i wrote this code:\nimport { api } from \"../../../config/api\";\n\nexport const getProducts = async (search) => {\n  let url = search ? `/products/search?q=${search}` : \"/products?limit=194\";\n  try {\n    let res = await api.get(url);\n    return res.data;\n  } catch (error) {\n    console.log(\"product api error: \", error);\n  }\n};\n\nexport const getProductsCategory = async () => {\n  try {\n    let res = await api.get(\"/products/categories\");\n    return res.data;\n  } catch (error) {\n    console.log(\"product api category error: \", error);\n  }\n};\n\nexport const getProductsByCategory = async (category) => {\n  try {\n    let res = await api.get(`/products/category/${category}`);\n    return res.data;\n  } catch (error) {\n    console.log(\"Get products by category error: \", error);\n  }\n};\n\ngetproducts function for get product by user search otherwise it's return all existed products.\nand geProductCategory function return all category of product that present in dummy.json api. and \ngetRpoductsByCategory function return user selected category products. \n\nthen product/hooks inside folder i create useProductHook.jsx file inside i wrote this code:\nimport { timeoutManager, useQuery } from \"@tanstack/react-query\";\nimport {\n  getProducts,\n  getProductsByCategory,\n  getProductsCategory,\n} from \"../api/ProductApi\";\nimport { useEffect, useState } from \"react\";\n\nexport const useAllProducts = () => {\n  const [search, setSearch] = useState(null);\n  const [debounce, setDebounce] = useState(null);\n\n  useEffect(() => {\n    const timeOut = setTimeout(() => {\n      setDebounce(search);\n    }, 700);\n    return () => clearTimeout(timeOut);\n  }, [search]);\n\n  const { data, isPending, error } = useQuery({\n    queryKey: [\"products\", debounce],\n    queryFn: () => getProducts(debounce),\n  });\n  return {\n    data,\n    isPending,\n    error,\n    search,\n    setSearch,\n  };\n};\n\nexport const useAllCategorys = () => {\n  return useQuery({\n    queryKey: [\"AllCategory\"],\n    queryFn: getProductsCategory,\n  });\n};\n\nexport const useProductByCategory = () => {\n  const [category, setCategory] = useState(null);\n  let { data, isPending, error } = useQuery({\n    queryKey: [\"productsByCategory\", category],\n    queryFn: () => getProductsByCategory(category),\n  });\n  return {\n    data,\n    isPending,\n    error,\n    category,\n    setCategory,\n  };\n};\n\n\nI used tanstack query for simply fetch data from api, and for loading state and for cache for\napi responce, means don't need to call api again on every render. \nfirst i useAllProducts function or we can say custom hook, inside I created search state,\nbebouce state, when user search then on setSearch get the input data, so every time our api\nhit so for that i used debouce concept, for that i created useEffect inside i wrote setTimout\nfunction and inside i store search input inside  SetDebouce state. then i set 700s timeout and\ni used cleanup function of useEffect for clear the time intervel and gave defendency array [search]\n and then i used useQuery inside i wrote queryKey and qeuryFn and callled getProducts(debouce)\nand return data, isPending, error, search, setSeach. \n \nonly I created another custom hook useAllCategory function inside this i used useQuery and gave\nqueryKey: [\"allCategory\"] and queryFn: getProductsCategory called.\n\nalso another custore hook is useProductByCategory function i created inside category state created\nand i used userQuery inside queryKey: [\"productsBYCategory\", category] and quryFun: called\n getProductsByCategory(category) and return data, ispending, error, category, setCategory. \n\nnow in product/ui/pages inside i creted productPage.jsx component inside i wrote this code:\nimport Filter from \"../../../../shared/ui/components/Filter\";\nimport {\n  useAllProducts,\n  useProductByCategory,\n} from \"../../hooks/useProductHook\";\nimport ProductCard from \"../components/ProductCart\";\n\nconst ProductPage = () => {\n  const { isPending, data, error, search, setSearch } = useAllProducts();\n  const {\n    data: productsByCategory,\n    category,\n    setCategory,\n  } = useProductByCategory();\n\n  if (isPending) return <h1>loading</h1>;\n  return (\n    <div>\n      <Filter\n        category={category}\n        setCategory={setCategory}\n        search={search}\n        setSearch={setSearch}\n      />\n      <div className=\"grid grid-cols-1 xl:grid-cols-5 p-4 lg:grid-cols-4 md:grid-cols-3 min-[450px]:grid-cols-2 max-[450px]:grid-1  gap-4\">\n        {productsByCategory?.products.length\n          ? productsByCategory.products.map((val) => (\n              <ProductCard key={val.id} product={val} />\n            ))\n          : data.products.map((val) => (\n              <ProductCard key={val.id} product={val} />\n            ))}\n      </div>\n    </div>\n  );\n};\n\nexport default ProductPage;\n\n then inside productPage i desturcture the custom hook isPending, data, error, serach, setSearch from\nuseAllProducts() custom hook and from useProductByCategory() hook I destructure\ndata: productsByCategory,\n    category,\n    setCategory,\nthen if isPending then return h1 inside loading text, \nand below return jsx. filter and pass props \n   <Filter\n        category={category}\n        setCategory={setCategory}\n        search={search}\n        setSearch={setSearch}\n      />\nin src/shared/ui/component folder i filter.jsx and productCart.jsx and wrote this below code.\nthis is for filter:\n\nimport { Search, ChevronDown } from \"lucide-react\";\nimport { useAllCategorys } from \"../../../features/product/hooks/useProductHook\";\n\nconst Filter = ({search, setSearch, category, setCategory}) => {\n  const { isPending, data, error } = useAllCategorys();\n\n  if (isPending) return <h1>Loading...</h1>;\n\n  return (\n    <div className=\"w-full rounded-2xl bg-zinc-900/25 p-3 shadow-xl shadow-black/20 backdrop-blur-xl\">\n      <div className=\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\">\n        {/* ================= SEARCH BAR ================= */}\n        <div className=\"group relative w-full sm:max-w-md\">\n          <Search\n            size={19}\n            className=\"pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500 transition-colors duration-300 group-focus-within:text-violet-400\"\n          />\n\n          <input\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            type=\"text\"\n            placeholder=\"Search products...\"\n            className=\"h-12 w-full rounded-xl border border-white/10 bg-zinc-950/80 pl-11 pr-4 text-sm text-white outline-none placeholder:text-zinc-600 transition-all duration-300 hover:border-white/20 focus:border-violet-500/50 focus:bg-zinc-950 focus:ring-4 focus:ring-violet-500/10\"\n          />\n        </div>\n\n        {/* ================= CATEGORY ================= */}\n        <div className=\"relative w-full sm:w-56\">\n          <select\n            value={category}\n            onChange={(e) => setCategory(e.target.value)}\n            className=\"h-12 w-full cursor-pointer appearance-none rounded-xl border border-white/10 bg-zinc-900 backdrop-blur-xl px-4 pr-11 text-sm font-medium text-zinc-300 outline-none transition-all duration-300 hover:border-white/20 focus:border-violet-500/50 focus:ring-4 focus:ring-violet-500/10\"\n            defaultValue=\"all\"\n          >\n            <option value=\"\">Select Category</option>\n            {data.map((item) => (\n              <option key={item.slug} value={item.slug}>\n                {item.name}\n              </option>\n            ))}\n          </select>\n\n          <ChevronDown\n            size={18}\n            className=\"pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-zinc-500\"\n          />\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Filter;\n\n\n\nthis is a product card code:\n\nimport { ShoppingCart, Star, ArrowUpRight } from \"lucide-react\";\n\nconst ProductCard = ({ product }) => {\n  const {\n    title,\n    price,\n    discountPercentage,\n    rating,\n    thumbnail,\n    category,\n    availabilityStatus,\n  } = product;\n\n  return (\n    <div className=\"group relative overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/70 shadow-xl shadow-black/20 backdrop-blur-sm transition-all duration-500 hover:-translate-y-1 hover:border-violet-500/40 hover:shadow-violet-500/10\">\n\n      {/* ================= IMAGE ================= */}\n      <div className=\"relative m-2 overflow-hidden rounded-xl bg-zinc-800\">\n        <img\n          src={thumbnail}\n          alt={title}\n          className=\"h-55 w-full object-cover transition-transform duration-700 group-hover:scale-110\"\n        />\n\n        {/* Discount */}\n        <div className=\"absolute left-3 top-3 rounded-full bg-violet-600 px-3 py-1 text-xs font-bold text-white shadow-lg\">\n          -{Math.round(discountPercentage)}%\n        </div>\n\n        {/* Quick View */}\n        <button\n          type=\"button\"\n          className=\"absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full border border-white/20 bg-black/50 text-white opacity-0 backdrop-blur-md transition-all duration-300 group-hover:opacity-100 hover:bg-violet-600\"\n        >\n          <ArrowUpRight size={17} />\n        </button>\n\n        {/* Image Overlay */}\n        <div className=\"pointer-events-none absolute inset-0 bg-linear-to-t from-black/30 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100\" />\n      </div>\n\n      {/* ================= CONTENT ================= */}\n      <div className=\"p-4\">\n\n        {/* Category + Stock */}\n        <div className=\"mb-2 flex items-center justify-between\">\n          <span className=\"text-xs font-medium capitalize text-violet-400\">\n            {category}\n          </span>\n\n          <span\n            className={`text-xs font-medium ${\n              availabilityStatus === \"In Stock\"\n                ? \"text-emerald-400\"\n                : \"text-red-400\"\n            }`}\n          >\n            {availabilityStatus}\n          </span>\n        </div>\n\n        {/* Title */}\n        <h2 className=\"line-clamp-2 min-h-12 text-base font-semibold leading-6 text-white transition-colors duration-300 group-hover:text-violet-400\">\n          {title}\n        </h2>\n\n        {/* Rating */}\n        <div className=\"mt-3 flex items-center gap-2\">\n          <div className=\"flex items-center gap-1 rounded-md bg-amber-400/10 px-2 py-1\">\n            <Star\n              size={14}\n              className=\"fill-amber-400 text-amber-400\"\n            />\n            <span className=\"text-xs font-semibold text-amber-300\">\n              {rating}\n            </span>\n          </div>\n\n          <span className=\"text-xs text-zinc-500\">\n            Customer rating\n          </span>\n        </div>\n\n        {/* Price */}\n        <div className=\"mt-4 flex items-end gap-2\">\n          <span className=\"text-2xl font-bold text-white\">\n            ${price}\n          </span>\n\n          <span className=\"pb-1 text-sm text-zinc-500 line-through\">\n            ${(price / (1 - discountPercentage / 100)).toFixed(2)}\n          </span>\n        </div>\n\n        {/* Add To Cart */}\n        <button\n          type=\"button\"\n          className=\"mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-linear-to-r from-violet-600 to-fuchsia-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-600/20 transition-all duration-300 hover:from-violet-500 hover:to-fuchsia-500 hover:shadow-violet-500/30 active:scale-[0.98]\"\n        >\n          <ShoppingCart size={18} />\n          Add to Cart\n        </button>\n      </div>\n    </div>\n  );\n};\n\nexport default ProductCard;\n\n\n\n\n\n\n\n",
      "autoResize": true,
